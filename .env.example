# ==============================================================================
# FACEEBINGO ENVIRONMENT SPECIFICATION (.env.example)
# Architecture: FastAPI + Supabase DB/Storage (REST API & Storage APIs)
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE INFRASTRUCTURE CONFIGURATION
# ------------------------------------------------------------------------------

# Base HTTPS URI for the target Supabase project REST API and Storage endpoints.
# Schema: https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# JWT Anon Key (Public API Key) authorizing client-side / backend API operations.
# Subject to Row Level Security (RLS) policies on PostgREST tables & storage objects.
SUPABASE_ANON_KEY=your-anon-key-here

# Target Supabase Storage object bucket identifier for binary uploads.
# Type: String (slug identifier)
# Default: facebingo-photos
SUPABASE_BUCKET=facebingo-photos

# Relational table identifier within the default PostgreSQL schema ('public').
# Type: String (table identifier)
# Default: encounters
SUPABASE_TABLE=encounters


# ------------------------------------------------------------------------------
# SECURITY & NETWORK CONTROLS
# ------------------------------------------------------------------------------

# JSON Array string specifying allowed origin headers for Cross-Origin Resource Sharing (CORS).
# Evaluated by FastAPI CORSMiddleware.
# Format: List[String] (JSON-serializable array)
# Default: ["*"]
ALLOWED_ORIGINS=["*"]

# Rate limiting quota specification string parsed by SlowAPI / limits library.
# Syntax: "<integer>/<unit>" where unit ∈ {second, minute, hour, day}
# Applied to state-mutating HTTP methods and administrative endpoints.
# Default: 20/minute
RATE_LIMIT=20/minute


# ------------------------------------------------------------------------------
# ADMINISTRATIVE AUTHENTICATION CREDENTIALS
# ------------------------------------------------------------------------------

# Plaintext identity credential for HTTP Basic Authentication realm challenge (RFC 7617).
# Protects administrative HTML views, statistics endpoints, and diagnostic routes.
# Type: String
ADMIN_USERNAME=admin

# Plaintext secret credential for HTTP Basic Authentication realm challenge (RFC 7617).
# Type: String
ADMIN_PASSWORD=change-me-before-deploying


# ------------------------------------------------------------------------------
# APPLICATION RUNTIME & DIAGNOSTICS
# ------------------------------------------------------------------------------

# Target deployment runtime environment state identifier.
# Enum: {development, staging, production}
# Controls internal state behavior and logging verbosity.
# Default: development
APP_ENV=development

# Standard logging severity threshold for the Python standard logging module.
# Enum: {DEBUG, INFO, WARNING, ERROR, CRITICAL}
# Default: INFO
LOG_LEVEL=INFO

# Application namespace metadata identifier string.
# Rendered in UI template headers and HTML meta tags.
# Default: FaceBingo
APP_TITLE=FaceBingo

# Application version identifier compliant with Semantic Versioning (SemVer 2.0.0).
# Default: 0.1.0
APP_VERSION=0.1.0