
# Supabase 
# Your Supabase project URL.
# Found at: Supabase Dashboard → Project Settings → API → Project URL
# Format:   https://<project-ref>.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / public API key (safe for client-side use).
# Found at: Supabase Dashboard → Project Settings → API → Project API keys → anon public
# This key is governed by Row Level Security (RLS) policies on your tables.
SUPABASE_ANON_KEY=your-anon-key-here

# Name of the Supabase Storage bucket used to store encounter photos.
# Create the bucket at: Supabase Dashboard → Storage → New bucket
# Set the bucket to PUBLIC so the returned CDN URLs are directly accessible.
# Default: facebingo-photos
SUPABASE_BUCKET=facebingo-photos

# Name of the Supabase Postgres table that stores encounter records.
# Run the DDL in the "Database Setup" section of README.md before starting the app.
# Default: encounters
SUPABASE_TABLE=encounters


# CORS 
# Comma-separated list of allowed origins for CORS requests.
# Use ["*"] during local development to allow all origins.
# In production, replace with your exact frontend domain(s), e.g.:
#   ALLOWED_ORIGINS=["https://facebingo.example.com","https://admin.facebingo.example.com"]
# Default: ["*"]
ALLOWED_ORIGINS=["*"]


# Rate Limiting 
# SlowAPI rate limit string applied to write endpoints (POST /submit) and
# the admin stats endpoint (GET /admin/stats).
# Format: "<count>/<period>"  — period is: second | minute | hour | day
# Examples: "10/minute"  "100/hour"  "5/second"
# Default: 20/minute
RATE_LIMIT=20/minute


# ── Admin Authentication ───────────────────────────────────────────────────────
# HTTP Basic Auth credentials that protect the /admin page, /admin/stats API,
# and all /debug/* endpoints.
# These are REQUIRED — the app will refuse to start if they are missing.
# Choose a strong, unique password. Do not reuse credentials from other systems.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying


# Application 
# Runtime environment identifier.
# Used to toggle debug behaviour and logging verbosity.
# Values: development | staging | production
# Default: development
APP_ENV=development

# Python logging level for the application logger.
# Values: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Use DEBUG locally to see all SQL and HTTP traffic.
# Use INFO or WARNING in production.
# Default: INFO
LOG_LEVEL=INFO

# Human-readable title shown in browser tabs and the admin dashboard header.
# Default: FaceBingo
APP_TITLE=FaceBingo

# Semantic version string displayed in the admin footer.
# Default: 0.1.0
APP_VERSION=0.1.0